# Required
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Operators' Telegram chat for hand-offs (group or private chat ID). Optional.
ADMIN_CHAT_ID=
FALLBACK_EMAIL=help@polarpedal.example

# polling (local dev, no public URL) or webhook (production)
MODE=polling
PUBLIC_URL=
WEBHOOK_SECRET=
PORT=8080

# Optional overrides
BUSINESS_NAME=Polar Pedal Bike Rental, Tromsø
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-2
KB_DIR=kb
INDEX_PATH=data/index.json
BOOKINGS_PATH=data/bookings.json
